// Release 4.1 — proposed schema additions (draft)
// Merge into prisma/schema.prisma during implementation sprints

enum GroupMemberRole {
  ADMIN
  MEMBER
}

enum GroupInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum SplitMode {
  EQUAL_INCLUDED
  CUSTOM_AMOUNT
  CUSTOM_PERCENT
}

enum ReminderRecurrence {
  NONE
  WEEKLY
  MONTHLY
}

enum ReminderChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

enum ReminderStatus {
  ACTIVE
  COMPLETED
  SNOOZED
  CANCELLED
}

