{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "sync-env": "node ./scripts/sync-env.mjs",
    "start": "node ./scripts/run-expo.mjs start",
    "start:clear": "node ./scripts/run-expo.mjs start --clear",
    "expo": "node ./scripts/run-expo.mjs",
    "android": "node ./scripts/run-expo.mjs start --android",
    "ios": "node ./scripts/run-expo.mjs start --ios",
    "web": "node ./scripts/run-expo.mjs start --web",
    "typecheck": "tsc --noEmit",
    "build:preview": "eas build --profile preview --platform all",
    "build:production": "eas build --profile production --platform all",
    "submit:ios": "eas submit --profile production --platform ios",
    "submit:android": "eas submit --profile production --platform android"
  },
  "dependencies": {
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@nexpo/shared": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.17",
    "@supabase/supabase-js": "^2.115.0",
    "axios": "^1.18.0",
    "dayjs": "^1.11.21",
    "expo": "~57.0.16",
    "expo-auth-session": "~57.0.11",
    "expo-constants": "~57.0.14",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.13",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-css-interop": "^0.2.7",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.28.0",
    "react-native-url-polyfill": "^4.0.0",
    "tailwindcss": "3.4.17",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
