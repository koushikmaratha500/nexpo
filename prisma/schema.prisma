// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  A
  D
  B
  I
  P
}

enum AuthProvider {
  EMAIL
  GOOGLE
  MOBILE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  BLOCK
  ACTIVATE
}

enum TransactionType {
  DEBIT
  CREDIT
}

model Country {
  id         String    @id @default(uuid())
  name       String    @unique
  isoCode    String    @unique
  currencyId String?
  currency   Currency? @relation(fields: [currencyId], references: [id])
  status     Status    @default(A)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  users      User[]
}

model Currency {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  symbol    String
  status    Status    @default(A)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  users      User[]
  transactions Transaction[]
  countries   Country[]
}

model User {
  id              String       @id @default(uuid())
  email           String?      @unique
  passwordHash    String?
  mobile          String?      @unique
  firstName       String
  lastName        String?
  profileImageUrl String?
  emailVerified   Boolean      @default(false)
  mobileVerified  Boolean      @default(false)
  provider        AuthProvider @default(EMAIL)
  countryId       String?
  currencyId      String?
  country         Country?     @relation(fields: [countryId], references: [id])
  currency        Currency?    @relation(fields: [currencyId], references: [id])
  status          Status       @default(A)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  transactions    Transaction[]
  sessions        Session[]
  userAudits      UserAudit[]
  passwordResetTokens PasswordResetToken[]
}

model Admin {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String?
  profileImageUrl String?
  status          Status    @default(A)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sessions        Session[]
  passwordResetTokens PasswordResetToken[]
}

model Category {
  id            String        @id @default(uuid())
  name          String        @unique
  code          String        @unique
  type          TransactionType       @default(CREDIT)
  color         String?
  icon          String?
  status        Status        @default(A)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transactions  Transaction[]
}

model PaymentType {
  id            String        @id @default(uuid())
  name          String        @unique
  code          String        @unique
  status        Status        @default(A)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transactions  Transaction[]
}

model BudgetType {
  id            String        @id @default(uuid())
  name          String        @unique
  code          String        @unique
  status        Status        @default(A)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transactions  Transaction[]
}

model BudgetDepositType {
  id            String        @id @default(uuid())
  name          String        @unique
  code          String        @unique
  status        Status        @default(A)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transactions  Transaction[]
}

model Transaction {
  id                  String           @id @default(uuid())
  userId              String
  type                TransactionType
  currencyId          String?
  categoryId          String?
  paymentTypeId       String?
  budgetDepositTypeId String?
  budgetTypeId        String?
  user                User             @relation(fields: [userId], references: [id])
  currency            Currency?        @relation(fields: [currencyId], references: [id])
  category            Category?        @relation(fields: [categoryId], references: [id])
  paymentType         PaymentType?     @relation(fields: [paymentTypeId], references: [id])
  budgetDepositType   BudgetDepositType? @relation(fields: [budgetDepositTypeId], references: [id])
  budgetType          BudgetType?      @relation(fields: [budgetTypeId], references: [id])
  title               String
  description         String?
  amount              Decimal          @db.Decimal(18, 2)
  transactionDate     DateTime
  notes               String?
  documentUrl         String?
  documentFileName    String?
  documentMimeType    String?
  documentSize        Int?
  merchant            String?
  status              String           @default("A")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  transactionAudits   TransactionAudit[]

  @@index([userId])
  @@index([type])
  @@index([transactionDate])
}

model TransactionAudit {
  id            String        @id @default(uuid())
  transactionId String
  transaction   Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  action        AuditAction
  oldValue      Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  status        String        @default("A")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([transactionId])
}

model Session {
  id         String    @id @default(uuid())
  jwt        String    @db.Text
  userId     String?
  adminId    String?
  user       User?     @relation(fields: [userId], references: [id])
  admin      Admin?    @relation(fields: [adminId], references: [id])
  loginTime  DateTime  @default(now())
  expiryTime DateTime
  logoutTime DateTime?
  status     Status    @default(A)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([adminId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  email     String
  adminId   String?
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  admin     Admin?    @relation(fields: [adminId], references: [id])
  expiresAt DateTime
  usedAt    DateTime?
  status    Status    @default(A)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
  @@index([adminId])
  @@index([userId])
}

model UserAudit {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  action    AuditAction
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  status    Status      @default(A)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

model AiUsage {
  id           String   @id @default(uuid())
  userId       String
  feature      String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  latencyMs    Int      @default(0)
  status       String   @default("OK")
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([feature])
}

model SupportTicket {
  id         String   @id @default(uuid())
  name       String
  email      String
  phone      String?
  message    String   @db.Text
  fileUrl    String?
  fileName   String?
  fileSize   Int?
  adminNotes String?  @db.Text
  status     Status   @default(A) // A=Open, I=Closed, D=Deleted
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supportAudits SupportTicketAudit[]
}

model SupportTicketAudit {
  id              String        @id @default(uuid())
  supportTicketId String
  supportTicket   SupportTicket @relation(fields: [supportTicketId], references: [id], onDelete: Cascade)
  adminId         String?
  action          AuditAction
  oldValue        Json?
  newValue        Json?
  ipAddress       String?
  userAgent       String?
  status          Status        @default(A)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([supportTicketId])
}
