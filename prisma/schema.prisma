// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  A
  D
  B
  I
  P
}

enum AuthProvider {
  EMAIL
  GOOGLE
  MOBILE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  BLOCK
  ACTIVATE
  PASSWORD_RESET
}

enum TransactionType {
  DEBIT
  CREDIT
}

enum GroupMemberRole {
  ADMIN
  MEMBER
}

enum GroupInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum SplitMode {
  EQUAL_INCLUDED
  CUSTOM_AMOUNT
  CUSTOM_PERCENT
}

enum ReminderRecurrence {
  NONE
  WEEKLY
  MONTHLY
}

enum ReminderStatus {
  ACTIVE
  COMPLETED
  SNOOZED
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  WHATSAPP
}

enum PushPlatform {
  WEB
  IOS
  ANDROID
}

model Country {
  id         String    @id @default(uuid())
  name       String    @unique
  isoCode    String    @unique
  currencyId String?
  currency   Currency? @relation(fields: [currencyId], references: [id])
  status     Status    @default(A)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  users      User[]
}

model Currency {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  symbol    String
  status    Status    @default(A)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  users      User[]
  transactions Transaction[]
  countries   Country[]
}

model User {
  id              String       @id @default(uuid())
  username        String?      @unique
  email           String?      @unique
  passwordHash    String?
  mobile          String?      @unique
  firstName       String
  lastName        String?
  profileImageUrl String?
  emailVerified   Boolean      @default(false)
  mobileVerified  Boolean      @default(false)
  provider        AuthProvider @default(EMAIL)
  countryId       String?
  currencyId      String?
  country         Country?     @relation(fields: [countryId], references: [id])
  currency        Currency?    @relation(fields: [currencyId], references: [id])
  status          Status       @default(A)
  forcedResetPassword Boolean   @default(false)
  lastPasswordChangedDate DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  transactions    Transaction[]
  sessions        Session[]
  userAudits      UserAudit[]
  passwordResetTokens PasswordResetToken[]
  groupMembers    GroupMember[]
  groupInvitesSent GroupInvite[] @relation("InvitedBy")
  createdGroups   Group[] @relation("GroupCreator")
  createdGroupTransactions Transaction[] @relation("GroupTransactionCreator")
  groupExpenseSplits GroupExpenseSplit[]
  paymentReminders PaymentReminder[] @relation("PersonalReminders")
  createdReminders PaymentReminder[] @relation("ReminderCreator")
  inAppNotifications InAppNotification[]
  notificationPreference UserNotificationPreference?
  pushSubscriptions UserPushSubscription[]
  transactionShares TransactionShare[]
}

model Admin {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String?
  profileImageUrl String?
  status          Status    @default(A)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sessions        Session[]
  passwordResetTokens PasswordResetToken[]
}

model Category {
  id            String        @id @default(uuid())
  name          String        @unique
  code          String        @unique
  type          TransactionType       @default(CREDIT)
  color         String?
  icon          String?
  status        Status        @default(A)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transactions  Transaction[]
}

model PaymentType {
  id            String        @id @default(uuid())
  name          String        @unique
  code          String        @unique
  status        Status        @default(A)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transactions  Transaction[]
}

model BudgetType {
  id            String        @id @default(uuid())
  name          String        @unique
  code          String        @unique
  status        Status        @default(A)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transactions  Transaction[]
}

model BudgetDepositType {
  id            String        @id @default(uuid())
  name          String        @unique
  code          String        @unique
  status        Status        @default(A)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transactions  Transaction[]
}

model Transaction {
  id                  String           @id @default(uuid())
  userId              String
  groupId             String?
  createdByUserId     String?
  splitMode           SplitMode?
  type                TransactionType
  currencyId          String?
  categoryId          String?
  paymentTypeId       String?
  budgetDepositTypeId String?
  budgetTypeId        String?
  user                User             @relation(fields: [userId], references: [id])
  group               Group?           @relation(fields: [groupId], references: [id])
  createdBy           User?            @relation("GroupTransactionCreator", fields: [createdByUserId], references: [id])
  currency            Currency?        @relation(fields: [currencyId], references: [id])
  category            Category?        @relation(fields: [categoryId], references: [id])
  paymentType         PaymentType?     @relation(fields: [paymentTypeId], references: [id])
  budgetDepositType   BudgetDepositType? @relation(fields: [budgetDepositTypeId], references: [id])
  budgetType          BudgetType?      @relation(fields: [budgetTypeId], references: [id])
  title               String
  description         String?
  amount              Decimal          @db.Decimal(18, 2)
  transactionDate     DateTime
  notes               String?
  documentUrl         String?
  documentFileName    String?
  documentMimeType    String?
  documentSize        Int?
  merchant            String?
  status              String           @default("A")
  isRecurring         Boolean          @default(false)
  recurringDay        Int?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  transactionAudits   TransactionAudit[]
  recurringActions    RecurringTransactionAction[]
  splits              GroupExpenseSplit[]
  shares              TransactionShare[]

  @@index([userId])
  @@index([groupId])
  @@index([createdByUserId])
  @@index([type])
  @@index([transactionDate])
  @@index([isRecurring])
}

model RecurringTransactionAction {
  id            String      @id @default(uuid())
  userId        String
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  dueDate       DateTime
  action        String      @default("APPROVED")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
  @@index([transactionId])
  @@unique([transactionId, dueDate])
}

model TransactionAudit {
  id            String        @id @default(uuid())
  transactionId String
  transaction   Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  action        AuditAction
  oldValue      Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  status        String        @default("A")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([transactionId])
}

model Session {
  id         String    @id @default(uuid())
  jwt        String    @db.Text
  userId     String?
  adminId    String?
  user       User?     @relation(fields: [userId], references: [id])
  admin      Admin?    @relation(fields: [adminId], references: [id])
  loginTime  DateTime  @default(now())
  expiryTime DateTime
  logoutTime DateTime?
  status     Status    @default(A)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([adminId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  email     String
  adminId   String?
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  admin     Admin?    @relation(fields: [adminId], references: [id])
  expiresAt DateTime
  usedAt    DateTime?
  status    Status    @default(A)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
  @@index([adminId])
  @@index([userId])
}

model UserAudit {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  action    AuditAction
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  status    Status      @default(A)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

model AiUsage {
  id           String   @id @default(uuid())
  userId       String
  feature      String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  latencyMs    Int      @default(0)
  status       String   @default("OK")
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([feature])
}

model SupportTicket {
  id         String   @id @default(uuid())
  name       String
  email      String
  phone      String?
  message    String   @db.Text
  fileUrl    String?
  fileName   String?
  fileSize   Int?
  adminNotes String?  @db.Text
  status     Status   @default(A) // A=Open, I=Closed, D=Deleted
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supportAudits SupportTicketAudit[]
}

model SupportTicketAudit {
  id              String        @id @default(uuid())
  supportTicketId String
  supportTicket   SupportTicket @relation(fields: [supportTicketId], references: [id], onDelete: Cascade)
  adminId         String?
  action          AuditAction
  oldValue        Json?
  newValue        Json?
  ipAddress       String?
  userAgent       String?
  status          Status        @default(A)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([supportTicketId])
}

model SystemSetting {
  key              String   @id
  value            Json
  updatedByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Group {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdById String
  createdBy   User     @relation("GroupCreator", fields: [createdById], references: [id])
  status      Status   @default(A)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     GroupMember[]
  invites     GroupInvite[]
  transactions Transaction[]
  reminders   PaymentReminder[]

  @@index([createdById])
}

model GroupExpenseSplit {
  id             String   @id @default(uuid())
  transactionId  String
  userId         String
  included       Boolean  @default(true)
  shareAmount    Decimal? @db.Decimal(18, 2)
  sharePercent   Decimal? @db.Decimal(5, 2)
  computedAmount Decimal  @db.Decimal(18, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])

  @@unique([transactionId, userId])
  @@index([userId])
}

model GroupMember {
  id        String          @id @default(uuid())
  groupId   String
  userId    String
  role      GroupMemberRole @default(MEMBER)
  joinedAt  DateTime        @default(now())
  group     Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupInvite {
  id            String            @id @default(uuid())
  groupId       String
  invitedById   String
  email         String?
  phone         String?
  username      String?
  inviteeUserId String?
  status        GroupInviteStatus @default(PENDING)
  expiresAt     DateTime
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  group         Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedBy     User              @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([groupId])
  @@index([email])
  @@index([phone])
  @@index([username])
}

model PaymentReminder {
  id              String             @id @default(uuid())
  userId          String?
  groupId         String?
  createdByUserId String
  title           String
  amount          Decimal?           @db.Decimal(18, 2)
  dueDate         DateTime
  recurrence      ReminderRecurrence @default(NONE)
  channels        String[]           @default(["IN_APP"])
  status          ReminderStatus     @default(ACTIVE)
  snoozedUntil    DateTime?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user       User?  @relation("PersonalReminders", fields: [userId], references: [id])
  group      Group? @relation(fields: [groupId], references: [id])
  createdBy  User   @relation("ReminderCreator", fields: [createdByUserId], references: [id])
  deliveries NotificationDelivery[]

  @@index([userId, dueDate])
  @@index([groupId, dueDate])
  @@index([status, dueDate])
}

model InAppNotification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model UserNotificationPreference {
  userId         String  @id
  inAppEnabled   Boolean @default(true)
  emailEnabled   Boolean @default(true)
  pushEnabled    Boolean @default(true)
  groupActivity  Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPushSubscription {
  id                 String       @id @default(uuid())
  userId             String
  onesignalPlayerId  String       @unique
  platform           PushPlatform @default(WEB)
  lastSeenAt         DateTime     @default(now())
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationDelivery {
  id         String              @id @default(uuid())
  reminderId String?
  userId     String?
  channel    NotificationChannel
  status     String              @default("SENT")
  error      String?
  sentAt     DateTime            @default(now())

  reminder PaymentReminder? @relation(fields: [reminderId], references: [id], onDelete: SetNull)

  @@index([reminderId])
  @@index([userId])
}

model TransactionShare {
  id            String    @id @default(uuid())
  token         String    @unique
  transactionId String
  createdById   String
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([createdById])
  @@index([expiresAt])
}
