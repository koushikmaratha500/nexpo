// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  A
  D
  B
  I
  P
}

enum AuthProvider {
  EMAIL
  GOOGLE
  MOBILE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  BLOCK
  ACTIVATE
}

model Country {
  id         String    @id @default(uuid())
  name       String    @unique
  isoCode    String    @unique
  currencyId String?
  currency   Currency? @relation(fields: [currencyId], references: [id])
  status     Status    @default(A)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  users      User[]
}

model Currency {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  symbol    String
  status    Status    @default(A)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  users     User[]
  expenses  Expense[]
  budgets   Budget[]
  countries Country[]
}

model User {
  id              String       @id @default(uuid())
  email           String?      @unique
  passwordHash    String?
  mobile          String?      @unique
  firstName       String
  lastName        String?
  profileImageUrl String?
  emailVerified   Boolean      @default(false)
  mobileVerified  Boolean      @default(false)
  provider        AuthProvider @default(EMAIL)
  countryId       String?
  currencyId      String?
  country         Country?     @relation(fields: [countryId], references: [id])
  currency        Currency?    @relation(fields: [currencyId], references: [id])
  status          Status       @default(A)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  expenses        Expense[]
  budgets         Budget[]
  sessions        Session[]
  userAudits      UserAudit[]
}

model Admin {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String?
  profileImageUrl String?
  status          Status    @default(A)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sessions        Session[]
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  code      String    @unique
  color     String?
  icon      String?
  status    Status    @default(A)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[]
}

model PaymentType {
  id        String    @id @default(uuid())
  name      String    @unique
  code      String    @unique
  status    Status    @default(A)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[]
  budgets   Budget[]
}

model Expense {
  id              String          @id @default(uuid())
  userId          String
  categoryId      String
  currencyId      String
  paymentTypeId   String
  user            User            @relation(fields: [userId], references: [id])
  category        Category        @relation(fields: [categoryId], references: [id])
  currency        Currency        @relation(fields: [currencyId], references: [id])
  paymentType     PaymentType     @relation(fields: [paymentTypeId], references: [id])
  title           String
  description     String?
  amount          Decimal         @db.Decimal(18, 2)
  expenseDate     DateTime
  notes           String?
  receiptUrl      String?
  receiptFileName String?
  receiptMimeType String?
  receiptSize     Int?
  status          Status          @default(A)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  expensesAudits  ExpensesAudit[]

  @@index([userId])
  @@index([categoryId])
  @@index([currencyId])
  @@index([paymentTypeId])
  @@index([expenseDate])
}

model BudgetType {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  status    Status   @default(A)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  budgets   Budget[]
}

model BudgetDepositType {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  status    Status   @default(A)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  budgets   Budget[]
}

model Budget {
  id                  String            @id @default(uuid())
  userId              String
  currencyId          String
  budgetDepositTypeId String
  paymentTypeId       String
  budgetTypeId        String
  user                User              @relation(fields: [userId], references: [id])
  currency            Currency          @relation(fields: [currencyId], references: [id])
  budgetDepositType   BudgetDepositType @relation(fields: [budgetDepositTypeId], references: [id])
  paymentType         PaymentType       @relation(fields: [paymentTypeId], references: [id])
  budgetType          BudgetType        @relation(fields: [budgetTypeId], references: [id])
  title               String
  amount              Decimal           @db.Decimal(18, 2)
  date                DateTime
  notes               String?
  documentUrl         String?
  documentFileName    String?
  documentMimeType    String?
  documentSize        Int?
  status              Status            @default(A)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  budgetAudits        BudgetAudit[]

  @@index([userId])
  @@index([currencyId])
  @@index([budgetDepositTypeId])
  @@index([paymentTypeId])
  @@index([budgetTypeId])
  @@index([date])
}

model Session {
  id         String    @id @default(uuid())
  jwt        String    @db.Text
  userId     String?
  adminId    String?
  user       User?     @relation(fields: [userId], references: [id])
  admin      Admin?    @relation(fields: [adminId], references: [id])
  loginTime  DateTime  @default(now())
  expiryTime DateTime
  logoutTime DateTime?
  status     Status    @default(A)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([adminId])
}

model UserAudit {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  action    AuditAction
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  status    Status      @default(A)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

model ExpensesAudit {
  id        String      @id @default(uuid())
  expenseId String
  expense   Expense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  action    AuditAction
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  status    Status      @default(A)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([expenseId])
}

model BudgetAudit {
  id        String      @id @default(uuid())
  budgetId  String
  budget    Budget      @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  action    AuditAction
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  status    Status      @default(A)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([budgetId])
}

model SupportTicket {
  id         String   @id @default(uuid())
  name       String
  email      String
  phone      String?
  message    String   @db.Text
  fileUrl    String?
  fileName   String?
  fileSize   Int?
  adminNotes String?  @db.Text
  status     Status   @default(A) // A=Open, I=Closed, D=Deleted
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supportAudits SupportTicketAudit[]
}

model SupportTicketAudit {
  id              String        @id @default(uuid())
  supportTicketId String
  supportTicket   SupportTicket @relation(fields: [supportTicketId], references: [id], onDelete: Cascade)
  adminId         String?
  action          AuditAction
  oldValue        Json?
  newValue        Json?
  ipAddress       String?
  userAgent       String?
  status          Status        @default(A)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([supportTicketId])
}
